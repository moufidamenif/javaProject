<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.1">
<persistence-unit name="javaPPU" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>com.example.javaP.models.User</class>
    <class>com.example.javaP.models.Role</class>
    <class>com.example.javaP.models.Access</class>
    <class>com.example.javaP.models.Permission</class>
    <properties>
        <!--  Database Connection  -->
        <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
        <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/javaproject1"/>
        <property name="jakarta.persistence.jdbc.user" value="root"/>
        <property name="jakarta.persistence.jdbc.password" value="moufida12345*&amp;"/>
        <!--  Hibernate Properties  -->
        <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
        <property name="hibernate.hbm2ddl.auto" value="update"/>
        <!--  This will create/update tables  -->
        <property name="hibernate.show_sql" value="true"/>
        <property name="hibernate.format_sql" value="true"/>
        <property name="hibernate.generate_statistics" value="true"/>
        <!--  To show statistics  -->
        <!--  Entity Scanning (optional, Hibernate will scan packages for entities)  -->
        <property name="hibernate.archive.autodetection" value="class"/>
    </properties>
</persistence-unit>
        </persistence>